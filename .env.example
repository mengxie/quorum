# Copy to .env for local development. Never commit .env.
QUORUM_DATABASE_URL=postgresql://quorum:quorum@localhost:5432/quorum
# Signs session cookies. Generate one: python -c "import secrets; print(secrets.token_urlsafe(40))"
QUORUM_SECRET_KEY=change-me-to-a-long-random-value-of-at-least-32-characters
# Set to true when served over HTTPS.
QUORUM_SECURE_COOKIES=false
